# Placeholders only. Copy to .env.production on your own machine ONLY to remember the values; never commit it
# (the repository .gitignore excludes .env.production). On the platforms, enter these in the secret stores.
# Every <...> is a placeholder. No model identifier and no key is provided by this repository.

# ---- Railway service variables (API) ----
ENV=production
WEB_ORIGIN=https://<your-vercel-production-domain>
DATABASE_URL=postgres://parallel_app.<SUPABASE_PROJECT_REF>:<APP_PASSWORD_URL_ENCODED>@<POOLER_HOST>:5432/postgres?sslmode=require
# Railway: the edge sets X-Real-IP. Do not set TRUSTED_PROXY_HOPS together with it.
CLIENT_IP_HEADER=X-Real-IP
# Self-hosted reverse proxy instead: unset CLIENT_IP_HEADER and set TRUSTED_PROXY_HOPS=<n>
RATE_LIMIT_RPS=50
RATE_LIMIT_BURST=100
MAX_CONCURRENT_SIMULATIONS=4
WORLD_CREATE_PER_HOUR_PER_IP=60
SHUTDOWN_TIMEOUT_SECONDS=25
RAILWAY_DEPLOYMENT_DRAINING_SECONDS=30
# LLM: leave all of these unset for the first deploy.
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=<openrouter key with a credit limit>
# LLM_MODEL=<model id you chose and tested>
# LLM_ACCESS_CODE=<long random string shared only with judges>
# LLM_MAX_CALLS_PER_WORLD=40
# LLM_GLOBAL_MAX_CALLS=400
# LLM_GLOBAL_MAX_TOKENS=2500000
# LLM_MAX_CONCURRENT_REQUESTS=2
# LLM_DUELS_PER_DAY_PER_IP=3

# ---- Migration step, run from your laptop only (never set on the running API) ----
# MIGRATE_DATABASE_URL=postgres://parallel_migrator.<SUPABASE_PROJECT_REF>:<MIGRATOR_PASSWORD_URL_ENCODED>@<POOLER_HOST>:5432/postgres?sslmode=require

# ---- Vercel (Production environment variable, set in the dashboard; public, inlined at build time) ----
# NEXT_PUBLIC_API_BASE_URL=https://<your-railway-domain>/api/v1
