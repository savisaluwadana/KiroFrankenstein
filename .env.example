# Copy to .env and adjust. Never commit .env. Placeholders only.

# PostgreSQL (local development defaults; dev passwords only, see docker/initdb/01-bootstrap.sh)
# Runtime role: no DDL, no UPDATE/DELETE on input_log.
DATABASE_URL=postgres://parallel_app:app_dev_password@localhost:5432/parallel?sslmode=disable
# Migration role (owner). Used only by `parallel-api migrate up|down|status`.
MIGRATE_DATABASE_URL=postgres://parallel_migrator:migrator_dev_password@localhost:5432/parallel?sslmode=disable

# Optional LLM opponent (OpenAI-compatible chat completions endpoint).
# The LLM opponent is unavailable until all three values are set.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=
# Limits (defaults shown; out-of-range values are rejected at startup).
# LLM_REQUEST_TIMEOUT_SECONDS=20          # 1..120
# LLM_MAX_CALLS_PER_WORLD=40              # 1..200
# LLM_MAX_TOKENS_PER_CALL=1024            # 64..8192, sent as max_tokens
# LLM_MAX_TOTAL_TOKENS_PER_WORLD=200000   # 1000..5000000, provider-reported usage
# Each call first reserves ceil(prompt bytes / 3) + max_tokens against the world
# and the server-wide limits; actual provider usage is then charged.
# LLM_MAX_PROMPT_BYTES=32768              # 1024..262144, larger prompts are not sent
# Server-wide limits across all worlds, per UTC calendar day (rebuilt at start-up).
# LLM_GLOBAL_MAX_CALLS=2000               # 1..1000000
# LLM_GLOBAL_MAX_TOKENS=5000000           # 1000..1000000000
# LLM_GLOBAL_WINDOW=day                   # only "day" (UTC) is supported
# LLM_MAX_CONCURRENT_REQUESTS=4           # 1..64 in-flight provider requests
# LLM_ACCESS_CODE=                        # optional secret: when set, starting an LLM opponent needs header X-Parallel-LLM-Code
# LLM_DUELS_PER_DAY_PER_IP=5              # 1..1000 LLM-backed starts per client IP per 24 h
# Optional OpenRouter attribution headers.
# LLM_HTTP_REFERER=
# LLM_APP_TITLE=

# Server hardening (defaults shown; out-of-range values are rejected at startup). See docs/deploy.md.
# ENV=production                     # strict start-up validation, HSTS behind https
# WEB_ORIGIN=https://parallel.example.com   # one exact origin; required (https) in production
# TRUSTED_PROXY_HOPS=0               # 0..5; required explicitly in production
# HTTP_REQUEST_TIMEOUT_SECONDS=30    # 1..120
# SHUTDOWN_TIMEOUT_SECONDS=25        # 1..120
# MAX_CONCURRENT_SIMULATIONS=8       # 1..64
# WORLD_CREATE_PER_HOUR_PER_IP=60    # 1..10000
# WRITE_TOKEN_FAILURES_PER_MINUTE=20 # 1..10000 invalid write tokens / LLM codes per IP per minute
# MAX_WORLDS=5000                    # 1..1000000, memory store only
